{
  "name": "runway-server",
  "version": "1.0.0",
  "description": "Runway AI Creative Platform Backend",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "demo-data:load": "node seed.js",
    "create-admin": "node scripts/create-admin.js",
    "dev": "node index.js",
    "migrate": "node scripts/migrate.js",
    "migrate:check": "node scripts/migrate.js --check",
    "syntax": "node scripts/check-syntax.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "audit:all": "npm audit --audit-level=low",
    "verify": "npm run syntax && npm test && npm run audit:all"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "overrides": { "uuid": "^11.1.1" }
}
