DATABASE_URL=postgresql://app_user:change-me@127.0.0.1:5432/runway
# Optional read-only/backup credential; defaults to DATABASE_URL when omitted.
BACKUP_DATABASE_URL=postgresql://backup_user:change-me@127.0.0.1:5432/runway
JWT_SECRET=replace-with-at-least-32-random-characters
SERVER_PORT=3001
CLIENT_PORT=5173
CORS_ORIGIN=http://127.0.0.1:5173
ALLOW_PUBLIC_REGISTRATION=false
ENABLE_PROTOTYPE_ROUTES=false
# Destructive fixture seed only: set all three deliberately for a disposable target.
ALLOW_DISPOSABLE_SEED=NO
DISPOSABLE_DATABASE_CONFIRMATION=runway_disposable
ALLOW_REMOTE_DISPOSABLE_SEED=NO
# OPENROUTER_API_KEY is optional; AI endpoints return 503 when it is absent.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Required only when an approved export provider is enabled.
EXPORT_PROVIDER_URL=https://export-gateway.example.com
EXPORT_PROVIDER_TOKEN=replace-with-export-provider-token
